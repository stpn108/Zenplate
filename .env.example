# Copy to .env and fill in. Never commit .env.

# --- Instance ---
COMPOSE_PROJECT_NAME=zenplate
PORTS_PREFIX=10                 # Host port prefix, e.g. 10 -> 10010

# --- Database (required) ---
POSTGRES_DB=zenplate
POSTGRES_USER=zenplate
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://zenplate:change-me@db/zenplate

# --- Backups (Ofelia job from callisto-services, see .claude/operations.md) ---
BACKUP_SCHEDULE=0 0 */4 * * *   # Ofelia cron with seconds: every 4 hours
BACKUP_RETENTION_DAYS=7

# --- Optional (with defaults) ---
TZ=Europe/Berlin
LOG_LEVEL=INFO
