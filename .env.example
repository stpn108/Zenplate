# Copy to .env and fill in. Never commit .env.

# --- Instance ---
COMPOSE_PROJECT_NAME=zenplate
PORTS_PREFIX=10                 # Host port prefix, e.g. 10 -> 10010

# --- Database (required) ---
POSTGRES_DB=zenplate
POSTGRES_USER=zenplate
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://zenplate:change-me@db/zenplate

# --- Backups (ofelia job on the db container, every 4h) ---
OFELIA_PREFIX=zenplate-         # MUST be unique per project on a shared server
BACKUP_PATH=./volumes/backups   # host directory for pg_dump files
BACKUP_RETENTION_DAYS=7

# --- Optional (with defaults) ---
TZ=Europe/Berlin
LOG_LEVEL=INFO
